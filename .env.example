# 前端访问的独立 API 地址。本地开发留空，由 Vite 代理到 http://localhost:3001。
# GitHub Pages workflow 使用 Actions repository variable BILI_SUB_API_BASE_URL。
VITE_API_BASE_URL=

# GitHub Pages 项目站使用 /仓库名/；自定义域名或 User Pages 使用 /。
# Pages workflow 可用 BILI_SUB_BASE_PATH repository variable 覆盖默认项目站路径。
VITE_BASE_PATH=/

# API 生产环境使用的随机密钥，至少 32 字节。
BILI_SUB_SESSION_SECRET=

# 额外允许的前端来源，多个地址使用英文逗号分隔。
BILI_SUB_ALLOWED_ORIGINS=
