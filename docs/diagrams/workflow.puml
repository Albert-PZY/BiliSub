@startuml
!pragma layout smetana
title BiliAISub 字幕处理工作流

skinparam backgroundColor #0B0E1E
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontColor #EDF0FF
skinparam titleFontSize 22
skinparam titleFontColor #EDF0FF
skinparam shadowing false
skinparam note {
  BackgroundColor #1B2145
  BorderColor #7C5CFF
  FontColor #C2C8EC
}
skinparam actor {
  BackgroundColor #7C5CFF
  BorderColor #7C5CFF
  FontColor #EDF0FF
}
skinparam roundcorner 8
skinparam ArrowColor #7C5CFF
skinparam ArrowThickness 1.2
skinparam activity {
  BackgroundColor #151B33
  BorderColor #3B4478
  FontColor #EDF0FF
  DiamondBackgroundColor #201A4D
  DiamondBorderColor #7C5CFF
  StartColor #7C5CFF
  EndColor #FF5C8A
}

start
:1  扫码登录\n建立服务端加密会话;
:2  添加视频\nBV 号 / 完整链接 / 短链接;
:3  解析视频\n返回标题与分 P;

if (包含多分 P？) then (是)
  :搜索并选择处理范围;
else (否)
  :自动选中当前视频;
endif

:4  创建字幕任务\n确定语言与处理范围;
repeat
  :获取一个分 P 的可用字幕轨道;
  :通过 NDJSON 推送结果\n立即更新任务列表;
repeat while (还有待处理分 P？) is (是) not (否)

:5  在线校对\n切换语言 / 恢复原文;
:6  按范围导出\nTXT / SRT / JSON;
stop

legend bottom
  单个分 P 完成后立即反馈，不等待整批任务结束
endlegend
@enduml
