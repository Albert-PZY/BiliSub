@startuml
!pragma layout smetana
title BiliAISub · 静态前端与独立 API 架构
left to right direction

skinparam backgroundColor #0B0E1E
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontColor #EDF0FF
skinparam titleFontSize 22
skinparam titleFontColor #EDF0FF
skinparam shadowing false
skinparam note {
  BackgroundColor #1B2145
  BorderColor #7C5CFF
  FontColor #C2C8EC
}
skinparam actor {
  BackgroundColor #7C5CFF
  BorderColor #7C5CFF
  FontColor #EDF0FF
}
skinparam roundcorner 8
skinparam linetype ortho
skinparam ArrowColor #7C5CFF
skinparam ArrowThickness 1.2
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #151B33
  BorderColor #3B4478
  FontColor #EDF0FF
}
skinparam node {
  BackgroundColor #171D3B
  BorderColor #7C5CFF
  FontColor #EDF0FF
}
skinparam artifact {
  BackgroundColor #10152C
  BorderColor #3B4478
  FontColor #C2C8EC
}
skinparam database {
  BackgroundColor #3A1430
  BorderColor #FF5C8A
  FontColor #FFD9E5
}
skinparam cloud {
  BackgroundColor #212A52
  BorderColor #868DBA
  FontColor #C2C8EC
}

actor "使用者" as User

node "GitHub Pages / 静态托管" as StaticHost {
  artifact "Vite 构建产物\ndist/" as Dist
}

node "用户浏览器 · React 19" as Browser {
  component "页面入口\nsrc/page.tsx" as Page
  component "规格视图\nsrc/specs.tsx" as Specs
  component "工作区状态\nsrc/hooks/use-subtitle-workspace.ts" as Workspace
  component "交互组件\nsrc/components/*" as Components
  component "API 客户端\nsrc/lib/local-api.ts" as LocalApi
  component "字幕模型\nsrc/lib/subtitles.ts" as Model
  component "浏览器导出\nTXT / SRT / JSON" as Export
}

node "Vercel · 独立 Next.js API\nRoot Directory: backend" as ApiHost {
  component "认证接口\nbackend/app/api/auth/*" as AuthApi
  component "视频解析接口\nbackend/app/api/videos/resolve" as ResolveApi
  component "字幕流接口\nbackend/app/api/subtitles" as SubtitleApi
  component "CORS 与输入限制\nbackend/lib/cors.ts\nbackend/lib/server/request.ts" as Guard
  component "B 站服务封装\nbackend/lib/server/bilibili.ts" as BiliClient
  database "AES-256-GCM 会话\nbili_ai_sub_session" as Session
  artifact "Vercel 配置\nbackend/vercel.json" as VercelConfig
}

cloud "Bilibili API" as Bilibili {
  component "扫码登录" as BiliAuth
  component "视频与分 P" as BiliVideo
  component "官方 AI 字幕" as BiliSubtitle
}

User --> Browser : 操作
StaticHost --> Browser : HTTPS 提供 dist/
Dist ..> StaticHost : 发布边界

Page --> Specs : Hash 路由
Page --> Components : 组合界面
Page --> Workspace : 触发任务
Workspace --> Model : 读取 / 更新字幕
Workspace --> LocalApi : JSON / NDJSON
Components --> Export : 触发下载

LocalApi --> AuthApi : 登录 / 状态
LocalApi --> ResolveApi : 批量解析
LocalApi --> SubtitleApi : 流式字幕

AuthApi --> Session : 写入 / 清除
ResolveApi --> Guard : 校验 / 去重 / 限制
SubtitleApi --> Guard : 校验 / 限制
SubtitleApi --> Session : 读取登录态
AuthApi --> BiliClient
ResolveApi --> BiliClient
SubtitleApi --> BiliClient
BiliClient --> BiliAuth : HTTPS
BiliClient --> BiliVideo : HTTPS
BiliClient --> BiliSubtitle : HTTPS

note bottom of Session
同源：HttpOnly Cookie。
跨域 Pages：白名单来源收到加密 token，
由 sessionStorage 以 Bearer 发送。
B 站 Cookie 只在服务端解密使用。
end note

note bottom of ApiHost
API 独立部署，Vercel Root Directory 为 backend。
end note

@enduml
