@startuml
!pragma layout smetana
title BiliAISub · 单一 Next.js 应用架构
left to right direction

skinparam backgroundColor #0B0E1E
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontColor #EDF0FF
skinparam titleFontSize 22
skinparam titleFontColor #EDF0FF
skinparam shadowing false
skinparam note {
  BackgroundColor #1B2145
  BorderColor #7C5CFF
  FontColor #C2C8EC
}
skinparam actor {
  BackgroundColor #7C5CFF
  BorderColor #7C5CFF
  FontColor #EDF0FF
}
skinparam roundcorner 8
skinparam linetype ortho
skinparam ArrowColor #7C5CFF
skinparam ArrowThickness 1.2
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #151B33
  BorderColor #3B4478
  FontColor #EDF0FF
}
skinparam node {
  BackgroundColor #171D3B
  BorderColor #7C5CFF
  FontColor #EDF0FF
}
skinparam artifact {
  BackgroundColor #10152C
  BorderColor #3B4478
  FontColor #C2C8EC
}
skinparam database {
  BackgroundColor #3A1430
  BorderColor #FF5C8A
  FontColor #FFD9E5
}
skinparam cloud {
  BackgroundColor #212A52
  BorderColor #868DBA
  FontColor #C2C8EC
}

actor "使用者" as User

node "Vercel · 单一 Next.js 应用\nRoot Directory: 仓库根目录" as AppHost {
  node "前端页面 · React 19" as Browser {
    component "工作台页面\napp/page.tsx" as Page
    component "根布局与 Provider\napp/layout.tsx" as Layout
    component "工作区状态\nhooks/use-subtitle-workspace.ts" as Workspace
    component "交互组件\ncomponents/*" as Components
    component "API 客户端\nlib/local-api.ts" as LocalApi
    component "字幕模型\nlib/subtitles.ts" as Model
    component "浏览器导出\nTXT / SRT / JSON" as Export
  }

  component "认证接口\napp/api/auth/*" as AuthApi
  component "视频解析接口\napp/api/videos/resolve" as ResolveApi
  component "字幕流接口\napp/api/subtitles" as SubtitleApi
  component "输入限制与 CORS\nlib/cors.ts\nlib/server/request.ts" as Guard
  component "B 站服务封装\nlib/server/bilibili.ts" as BiliClient
  component "样式与设计系统\napp/globals.css" as Style
  database "AES-256-GCM 会话\nbili_ai_sub_session" as Session
  artifact "Vercel 配置\nvercel.json" as VercelConfig
}

cloud "Bilibili API" as Bilibili {
  component "扫码登录" as BiliAuth
  component "视频与分 P" as BiliVideo
  component "官方 AI 字幕" as BiliSubtitle
}

User --> Browser : HTTPS 访问
Layout --> Page : 渲染
Layout --> Style : 载入
Page --> Components : 组合界面
Page --> Workspace : 触发任务
Workspace --> Model : 读取 / 更新字幕
Workspace --> LocalApi : 同源 JSON / NDJSON
Components --> Export : 触发下载

LocalApi --> AuthApi : 登录 / 状态
LocalApi --> ResolveApi : 批量解析
LocalApi --> SubtitleApi : 流式字幕

AuthApi --> Session : 写入 / 清除
ResolveApi --> Guard : 校验 / 去重 / 限制
SubtitleApi --> Guard : 校验 / 限制
SubtitleApi --> Session : 读取登录态
AuthApi --> BiliClient
ResolveApi --> BiliClient
SubtitleApi --> BiliClient
BiliClient --> BiliAuth : HTTPS
BiliClient --> BiliVideo : HTTPS
BiliClient --> BiliSubtitle : HTTPS

note bottom of Session
页面与 /api/* 同源，
会话只写入 HttpOnly Cookie。
若前端被单独部署到白名单里的其他 origin，
额外下发加密 token 供 Bearer 使用；
B 站 Cookie 只在服务端解密。
end note

note bottom of AppHost
页面与 API 由同一次部署提供，
不存在独立 API 地址或 VITE_ 环境变量。
end note

@enduml
